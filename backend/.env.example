# ─── Security ───────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Database ────────────────────────────────────────────────────────────────
# Overridden in docker-compose to use /app/storage volume
DATABASE_URL=sqlite:///./seo_platform.db

# ─── Redis / Celery ──────────────────────────────────────────────────────────
# Overridden in docker-compose to use service name "redis"
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
USE_CELERY=false

# ─── CORS (add your production domain here) ─────────────────────────────────
# CORS_ORIGINS=["http://localhost:5173","https://your-domain.com"]

# ─── Phase 10: AI Intelligence (optional) ───────────────────────────────────
# Leave blank to use the built-in rule-based engine (no API key required).
# Set to your OpenAI API key to enable GPT-powered suggestion enrichment.
OPENAI_API_KEY=
AI_ENABLED=true

# ─── Phase 10: Structured Logging ───────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR  (default: INFO)
# LOG_FORMAT: text (coloured dev output) | json (machine-parseable, use in prod)
LOG_LEVEL=INFO
LOG_FORMAT=text
